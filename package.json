{
  "name": "lithium-client",
  "version": "0.1.0",
  "description": "Lithium Intelligence local execution client for Windows and Linux.",
  "type": "module",
  "private": false,
  "license": "UNLICENSED",
  "homepage": "https://ai.lithium.dev.br",
  "repository": {
    "type": "git",
    "url": "https://github.com/lithium/client.git"
  },
  "bugs": {
    "url": "https://github.com/lithium/client/issues"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "start": "bun src/client-entry.ts",
    "start:linux": "bun src/linux-node-entry.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "verify": "bun scripts/verify-boundary.ts",
    "build:windows": "bun scripts/build-windows.ts",
    "build:linux": "bun scripts/build-linux.ts",
    "build:release": "bun run build:windows && bun run build:linux && bun scripts/checksums.ts",
    "checksums": "bun scripts/checksums.ts",
    "release:verify-tag": "bun scripts/verify-release-tag.ts"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
